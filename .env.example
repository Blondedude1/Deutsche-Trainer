# Passcode that unlocks the whole app (single user)
APP_PASSCODE=change-me

# Supabase (Project Settings → API). The service-role key stays on the server only.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Optional: "local" stores data in .data/db.json (dev/testing only, never on Vercel).
# Defaults to "supabase" when SUPABASE_URL is set, otherwise "local".
# DATA_BACKEND=local

# Phase 3 (leave off until you add Anthropic API credits)
AI_GRADING=off
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
